{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/geheimnisse_pruefen.sh\" || exit 2",
            "statusMessage": "Prüfe auf Zugangsdaten …",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/geheimnisse_pruefen.sh\" || exit 2",
            "statusMessage": "Prüfe auf Zugangsdaten …",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/kerntests.sh\"",
            "statusMessage": "Kerntests …",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(python3 -m pytest*)",
      "Bash(node --check*)"
    ]
  }
}

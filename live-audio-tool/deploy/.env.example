# Nach .env kopieren und ausfüllen:  cp .env.example .env

# Deine (Sub-)Domain – der DNS-A-Eintrag muss auf den Server zeigen
DOMAIN=audio.example.de

# Zugriffsschutz (Basic-Auth). Hash erzeugen:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'DEIN-PASSWORT'
# ACHTUNG: jedes $ im Hash hier als $$ schreiben (docker-compose-Escaping)!
BASIC_AUTH_USER=ich
BASIC_AUTH_HASH=$$2a$$14$$ERSETZE-MICH

# Hugging-Face-Token für die pyannote-Engine (leer = eingebaute Engine)
HF_TOKEN=
